{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tap-na",
  "account_id": "90cfcc1f7ec6362997f8b063c094c308",
  "main": "worker/index.js",
  "compatibility_date": "2026-07-25",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "vars": {
    "SUPABASE_URL": "https://mjfkthjxqvedqhpemxmt.supabase.co",
    "CLOUDFLARE_ACCOUNT_ID": "90cfcc1f7ec6362997f8b063c094c308",
    "EMAIL_FROM": "tap-na <welcome@tapnam.com>"
  },
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "routes": [
    {
      "pattern": "redirct.link",
      "custom_domain": true
    },
    {
      "pattern": "www.redirct.link",
      "custom_domain": true
    },
    {
      "pattern": "tapnam.com",
      "custom_domain": true
    },
    {
      "pattern": "www.tapnam.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
