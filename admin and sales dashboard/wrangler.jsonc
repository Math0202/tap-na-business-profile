{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tap-na-admin",
  "account_id": "90cfcc1f7ec6362997f8b063c094c308",
  "main": "worker/admin-spa.js",
  "compatibility_date": "2026-07-25",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "admin.tapnam.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
